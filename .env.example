# .env file template
# Copy this file to .env and fill in your values.

# Email to send the notification to
NOTIFY_EMAIL=your-email@example.com

# SMTP Server Configuration
# If using Gmail, you can use smtp.gmail.com and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Optional: Schedule for the EasySMX check. 
# Uses standard cron format. Defaults to "@daily".
# For testing, you can set it to "* * * * *" (every minute).
EASYSMX_SCHEDULE=@daily
